# ═══════════════════════════════════════════════════════════════════════
# 论文实验公共基线参数
# 所有实验通过 @configs/thesis_base.args 引入此文件，再用命令行覆盖差异项
# ═══════════════════════════════════════════════════════════════════════

# ── 编队规模 ──────────────────────────────────────────────────────────
--n_drones_per_group 1
--batch_size 64

# ── 训练超参 ──────────────────────────────────────────────────────────
--num_iters 5000
--timesteps 150
--lr 1e-3
--grad_decay 0.4

# ── 场景生成 ──────────────────────────────────────────────────────────
--random_scene
--safe_spawn
--safe_clearance 1.0
--force_cross_map
--spawn_z_max 3.0
--arena_range 8.0
--ground_ratio 0.6
--num_samples 50000
--enable_dynamic_obstacles

# ── 相机 / 渲染 ───────────────────────────────────────────────────────
--image_height 48
--image_width 64
--hfov 79
--depth_max 24.0
--depth_min 0.3
--cam_angle 10
--cam_rand_rpy 2.0
--cam_rand_xy 0.02

# ── 默认损失函数权重 ──────────────────────────────────────────────────
--coef_v 1.0
--coef_v_pred 2.0
--coef_collide 5.0
--coef_obj_avoidance 2.0
--coef_d_acc 0.01
--coef_d_jerk 0.001
--coef_lateral 0.3
--coef_ground_affinity 0.01
--ga_z_ceiling 5.0
--window_size 30

# ── 默认模型 ──────────────────────────────────────────────────────────
--model_type bigger
--sensor_mode depth

# ── 物理参数 (对齐参考项目) ───────────────────────────────────────────
--margin_min 0.3
--margin_max 0.8
--noise_std 0.04
--random_init_yaw

# ── 保存 ──────────────────────────────────────────────────────────────
--save_freq 200
--gpu 0
